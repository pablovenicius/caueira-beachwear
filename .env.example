# Copie este arquivo para .env.local e preencha com as credenciais reais.
# Na Vercel, cadastre as mesmas variáveis em Project Settings → Environment Variables.

# Supabase (Project Settings → API, no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role key (Project Settings → API → Project API keys →
# service_role). NUNCA leve essa chave pro navegador — sem o prefixo
# NEXT_PUBLIC_, ela só é lida no servidor (usada pelo webhook do Mercado Pago).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site, sem barra no final (ex.: https://caueira-beachwear.vercel.app
# em produção, ou http://localhost:3000 em desenvolvimento). Usada nos links
# de retorno do Mercado Pago e no webhook.
NEXT_PUBLIC_SITE_URL=

# Mercado Pago (Suas integrações → sua aplicação → Credenciais, no painel do
# Mercado Pago). Use o Access Token de TESTE enquanto estiver testando, e
# troque pelo de PRODUÇÃO só quando for vender de verdade.
MERCADOPAGO_ACCESS_TOKEN=
